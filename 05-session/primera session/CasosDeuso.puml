@startuml UseCaseDiagram_Airport

actor Employee
actor Passenger
actor SecurityEmployee as Security

usecase "Register Flight" as UC1
usecase "Sell Ticket" as UC2
usecase "Register Passenger" as UC3
usecase "Control Access" as UC4
usecase "Manage Incidents" as UC5

Employee --> UC1
Employee --> UC2
Employee --> UC3
Employee --> UC5
Security --> UC4
Passenger --> UC3

UC2 --> UC3 : <<include>>
UC2 --> UC1 : <<extend>>

@enduml
